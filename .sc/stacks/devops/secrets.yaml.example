# ШАБЛОН .sc/stacks/devops/secrets.yaml для деплоя AstroFit через Simple Container.
# Копия в проект-репозиторий Fit-astrology- (ветка из PR #1) при разблокировке деплоя.
#
# Скопируйте в .sc/stacks/devops/secrets.yaml и заполните значениями из секретов Forge:
#   astrofit-yc-sa-key           -> auth.yc.serviceAccountKey (полный JSON из `yc iam key create --output`)
#   astrofit-yc-static-key       -> auth.yc.accessKey + auth.yc.secretAccessKey (из `yc iam access-key create`)
#   astrofit-yc-cloud-id         -> auth.yc.cloudId
#   astrofit-yc-folder-id        -> auth.yc.folderId
#   astrofit-sc-state-passphrase -> values.state-passphrase (случайная строка; шифрует Pulumi-стейт)
#
# Структура 1:1 с гайдом docs.simple-container.com/guides/parent-yandex-cloud/ (Step 1),
# сверено по живой странице 2026-11-06.
#
# ⚠️ ПОСЛЕ ЗАПОЛНЕНИЯ, ДО ЛЮБОГО git add:
#     sc secrets add .sc/stacks/devops/secrets.yaml   # регистрация + .gitignore
#     echo "Y" | sc secrets hide                       # шифрование в .sc/secrets.yaml
#     git add .sc/secrets.yaml                         # коммитится ТОЛЬКО реестр
#     rm -f .sc/stacks/devops/secrets.yaml             # plaintext-копию удалить руками
#   Никогда не коммитьте заполненный файл и не используйте `git add -A`.

schemaVersion: 1.0

auth:
  yc:
    type: yc-service-account
    cloudId: "${ASTROFIT_YC_CLOUD_ID}"       # b1g...
    folderId: "${ASTROFIT_YC_FOLDER_ID}"     # b1g...
    # Полное содержимое `yc iam key create --output` для СА с admin на folder.
    serviceAccountKey: |
      {
        "id": "...",
        "service_account_id": "...",
        "created_at": "...",
        "key_algorithm": "RSA_2048",
        "public_key": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n",
        "private_key": "PLEASE DO NOT REMOVE THIS LINE! Yandex.Cloud SA Key ID <...>\n-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
      }
    # Статическая пара ключей (yc iam access-key create) — подписывает S3-вызовы
    # Object Storage и Container Registry.
    accessKey: "${ASTROFIT_YC_ACCESS_KEY}"       # YCAJE...
    secretAccessKey: "${ASTROFIT_YC_SECRET_ACCESS_KEY}"
    region: ru-central1
    zone: ru-central1-a

values:
  # Произвольная случайная строка; passphrase-провайдер шифрует ею Pulumi-стейт.
  state-passphrase: "${ASTROFIT_SC_STATE_PASSPHRASE}"
